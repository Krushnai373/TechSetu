  "classroom_phrases": [
    {
      "id": "cp_1",
      "category": "greeting",
      "hindi": "नमस्ते बच्चों, आप सब कैसे हैं?",
      "santhali_olchiki": "ᱡᱚᱦᱟᱨ ᱜᱤᱫᱽᱨᱟᱹ ᱠᱚ, ᱟᱯᱮ ᱪᱮᱫ ᱞᱮᱠᱟ ᱢᱮᱱᱟᱜ ᱯᱮᱭᱟ?",
      "santhali_devanagari": "जोहार गिद्रा को, आपे चेद लेका मेनाग पेया?",
      "santhali_phonetic": "Johar gidra ko, aape ched leka menag peya?",
      "ho_devanagari": "जोहार हुनको, आपे चिलका मेनापिया?",
      "ho_phonetic": "Johar hunko, aape chilka menapiya?",
      "mundari_devanagari": "जोहार होनको, आपे चिलेका मेनापिया?",
      "mundari_phonetic": "Johar honko, aape chileka menapiya?",
      "english": "Hello children, how are you all?"
    },
    {
      "id": "cp_2",
      "category": "instruction",
      "hindi": "कृपया अपनी किताब खोलिए।",
      "santhali_olchiki": "ᱫᱟᱭᱟᱠᱟᱛᱮ ᱟᱢᱟᱜ ᱯᱚᱛᱚᱵ ᱡᱷᱤᱡᱽ ᱢᱮ᱾",
      "santhali_devanagari": "दायाकाते आमाग पोतोब झिज मे।",
      "santhali_phonetic": "Dayakate aamag potob jhij me.",
      "ho_devanagari": "दायाकिते आमा पुथी निड़ में।",
      "ho_phonetic": "Dayakite aama puthi nir men.",
      "mundari_devanagari": "दायाकिते आमाः पोथी निड़ में।",
      "mundari_phonetic": "Dayakite aamaah pothi nir men.",
      "english": "Please open your book."
    },
    {
      "id": "cp_3",
      "category": "instruction",
      "hindi": "सभी बच्चे अपनी जगह पर बैठ जाओ।",
      "santhali_olchiki": "ᱥᱟᱱᱟᱢ ᱜᱤᱫᱽᱨᱟᱹ ᱟᱯᱱᱟᱨ ᱴᱷᱟᱶ ᱨᱮ ᱫᱩᱲᱩᱵ ᱯᱮ᱾",
      "santhali_devanagari": "सानाम गिद्रा आपनार ठांव रे दुड़ुब पे।",
      "santhali_phonetic": "Sanam gidra apnar thaw re durub pe.",
      "ho_devanagari": "सोबेन हुनको आपना जागा रे दुब पे।",
      "ho_phonetic": "Soben hunko aapna jaaga re dub pe.",
      "mundari_devanagari": "सोबेन होनको आपनाः ठांव रे दुब पे।",
      "mundari_phonetic": "Soben honko aapnaah thaonw re dub pe.",
      "english": "All children please sit down at your places."
    },
    {
      "id": "cp_4",
      "category": "encouragement",
      "hindi": "बहुत बढ़िया! आपने बहुत अच्छा किया।",
      "santhali_olchiki": "ᱟᱹᱰᱤ ᱱᱟᱯᱟᱭ! ᱟᱢ ᱟᱹᱰᱤ ᱵᱷᱟᱹᱜᱤᱢ ᱠᱟᱹᱢᱤ ᱠᱮᱫᱟ᱾",
      "santhali_devanagari": "आडी नापाय! आम आडी भागीम कामी केदा।",
      "santhali_phonetic": "Adi napay! Aam adi bhagim kami keda.",
      "ho_devanagari": "एतों बगे! आम एतों बगेम बाई केदा।",
      "ho_phonetic": "Eton bage! Aam eton bagem baai keda.",
      "mundari_devanagari": "एतों बुगि! आम एतों बुगिम बाई केदा।",
      "mundari_phonetic": "Eton bugi! Aam eton bugim baai keda.",
      "english": "Very good! You did very well."
    },
    {
      "id": "cp_5",
      "category": "question",
      "hindi": "क्या आपको समझ आया?",
      "santhali_olchiki": "ᱪᱮᱫ ᱟᱢ ᱵᱩᱡᱷᱟᱹᱣ ᱠᱮᱫᱟ?",
      "santhali_devanagari": "चेद आम बुझाव केदा?",
      "santhali_phonetic": "Ched aam bujhaw keda?",
      "ho_devanagari": "चिना आम बुझौ केदा?",
      "ho_phonetic": "China aam bujhow keda?",
      "mundari_devanagari": "चिनाः आम बुझौ केदा?",
      "mundari_phonetic": "Chinaah aam bujhow keda?",
      "english": "Did you understand?"
    },
    {
      "id": "cp_6",
      "category": "instruction",
      "hindi": "श्यामपट्ट की ओर देखो।",
      "santhali_olchiki": "ᱵᱽᱞᱮᱠᱵᱳᱨᱰ ᱥᱮᱫ ᱠᱚᱭᱚᱜᱽ ᱢᱮ᱾",
      "santhali_devanagari": "ब्लैकबोर्ड सेद कोयॉग मे।",
      "santhali_phonetic": "Blackboard sed koyog me.",
      "ho_devanagari": "बोर्ड पा मुतुन में।",
      "ho_phonetic": "Board paa mutun men.",
      "mundari_devanagari": "बोर्ड पा मुतुन में।",
      "mundari_phonetic": "Board paa mutun men.",
      "english": "Look towards the blackboard."
    },
    {
      "id": "cp_7",
      "category": "dialogue",
      "hindi": "तुम्हारा नाम क्या है?",
      "santhali_olchiki": "ᱟᱢᱟᱜ ᱧᱩᱛᱩᱢ ᱫᱚ ᱪᱮᱫ?",
      "santhali_devanagari": "आमाग ञुतुम दो चेद?",
      "santhali_phonetic": "Aamag nyutum do ched?",
      "ho_devanagari": "आमा नुतुम चिना?",
      "ho_phonetic": "Aama nutum china?",
      "mundari_devanagari": "अम-आः नुतुम चिनाः?",
      "mundari_phonetic": "Am-aah nutum chinaah?",
      "english": "What is your name?"
    },
    {
      "id": "cp_8",
      "category": "dialogue",
      "hindi": "मेरा नाम बिरसा है।",
      "santhali_olchiki": "ᱤᱧᱟᱜ ᱧᱩᱛᱩᱢ ᱫᱚ ᱵᱤᱨᱥᱟ ᱠᱟᱱᱟ᱾",
      "santhali_devanagari": "इञाग ञुतुम दो बिरसा काना।",
      "santhali_phonetic": "Inyag nyutum do Birsa kana.",
      "ho_devanagari": "आईंग-आ नुतुम बिरसा ताना।",
      "ho_phonetic": "Aying-aa nutum Birsa tana.",
      "mundari_devanagari": "आईंग-आः नुतुम बिरसा तनाः।",
      "mundari_phonetic": "Aying-aah nutum Birsa tanaah.",
      "english": "My name is Birsa."
    }
  ],
